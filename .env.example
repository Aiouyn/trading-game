# Port Avalon private alpha. Copy to a file you do not commit.
# No value here is a secret. Leave paid-provider lines commented out.
# QUAY_SPEND_OPT_IN=1 is the owner's yes to accept a paid configuration.
# It does not provision a project and does not open a connection.

# --- Spend guard (M3-06) ---
# Unset or exactly 1. Any other value refuses to boot.
# QUAY_SPEND_OPT_IN=1
# QUAY_KILL_SWITCH=1

# Paid hosting. Vercel sets VERCEL itself. Unset locally.
# VERCEL=

# Paid database. Any one of these without QUAY_SPEND_OPT_IN=1 refuses to boot.
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=

# Remote analytics or log sinks. The local jsonl under .data/telemetry is not one of these.
# QUAY_ANALYTICS_SINK=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# POSTHOG_KEY=
# QUAY_LOG_SINK=
# LOGTAIL_SOURCE_TOKEN=
# AXIOM_TOKEN=
# DATADOG_API_KEY=

# External tick host. The in-process 5s clock does not use this.
# QUAY_TICK_HOST=

# --- Local server (defaults are fine for one process on this machine) ---
# QUAY_AUTH_STORE=memory
# QUAY_AUTH_DATA_DIR=.data/auth
# QUAY_AUTH_MULTI_PROCESS=1
# Pin CSRF to one host. When set, only configured hosts pass.
# QUAY_PUBLIC_HOST=
# Extra CSRF hosts, comma-separated. Works without QUAY_TRUST_PROXY.
# QUAY_TRUSTED_HOSTS=
# Exactly 1 believes X-Forwarded-Host and X-Forwarded-For. Required for a non-loopback bind.
# QUAY_TRUST_PROXY=1
# QUAY_STORM_STORE=memory
# QUAY_STORM_DATA_DIR=.data/market
# QUAY_TELEMETRY_DIR=.data/telemetry
# QUAY_TELEMETRY_SECRET=

# Optional city asset origin. Empty uses same-origin URLs.
# NEXT_PUBLIC_CITY_CDN=

# Injected at build by next.config.ts (package version and git SHA). Override only if you mean to.
# NEXT_PUBLIC_RELEASE=
# NEXT_PUBLIC_BUILD_SHA=

# --- Do not set these on a real host. They ship test hooks. ---
# QUAY_DS=1
# QUAY_HOOKS=1
# NEXT_PUBLIC_CITY_E2E=1
# NEXT_PUBLIC_QUAY_E2E=1
# QUAY_OFFICIAL_E2E_BUILD=1
# NEXT_PUBLIC_QUAY_MOCK_PHASE=1
# NEXT_PUBLIC_QUAY_MOCK_CITY_FAIL=1
# NEXT_PUBLIC_QUAY_MOCK_LOAD_FAIL=1

# --- npm run ready (not read by the Next server) ---
# READY_URL=http://127.0.0.1:3000
