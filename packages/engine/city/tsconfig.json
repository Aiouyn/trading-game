{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "types": ["node"], "isolatedModules": true, "resolveJsonModule": true,
    "paths": { "zod": ["./node_modules/zod"], "@tycoon/params": ["../../params/src/index.ts"], "@tycoon/content": ["../../content/src/view.ts"], "@tycoon/engine-core": ["../core/index.ts"], "@tycoon/engine-ledger": ["../ledger/src/index.ts"], "@tycoon/engine-macro": ["../macro/schema.ts"] }
  },
  "include": ["**/*.ts", "eslint.config.mjs"],
  "exclude": ["node_modules"]
}
